# ============================================================
# ITA Member Directory — environment
# Copy to .env.local for local dev. In production these live in Vercel's
# Project → Settings → Environment Variables. NEVER commit .env.local.
# ============================================================

# ---- The directory source sheet ----
# Accepts a full Google Sheets URL or a bare spreadsheet ID.
# SHARE THIS SHEET (Viewer) with the service account below, or every read 404s.
DIRECTORY_SHEET_ID=https://docs.google.com/spreadsheets/d/1q7uIsPd5zhzeWtc3lFMcy34gl36Dpbsg_RClkNqzMiY/edit

# Optional. Blank = read the spreadsheet's FIRST tab, which is what the ITA
# export produces (its tab name changes on each re-export). Set this only if the
# directory ever moves to a named tab in a multi-tab workbook.
DIRECTORY_TAB=

# ---- Google service account (SAME one as the Aligned KPIs app) ----
# Copy both values from that project's Vercel env vars.
GOOGLE_SA_EMAIL=sheets-reader@to100-control.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Preferred alternative when an env manager mangles the newlines above: the same
# key, base64-encoded. If set, it wins.
GOOGLE_SA_PRIVATE_KEY_B64=

# ---- Auth ----
# Signs both the NextAuth session and the magic-link tokens.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# The public origin, used to build magic-link URLs. Locally: http://localhost:3000
# In production: the Vercel domain (no trailing slash).
APP_URL=http://localhost:3000

# REQUIRED FOR LOCAL DEV. NextAuth v5 refuses to serve a host it hasn't been
# told to trust ("UntrustedHost"), which locally means every sign-in fails with
# a 500 and no obvious cause. Vercel is detected automatically, so this is a
# local-only line — but without it `npm run dev` sign-in simply doesn't work.
AUTH_TRUST_HOST=true

# Who may sign in, on top of everyone in the directory sheet:
#   STAFF_EMAIL_DOMAINS — our own team (exact domain match). Default: 1to100advisors.com
#   EXTRA_ALLOWED_EMAILS — comma-separated escape hatch for an ITA officer, or a
#   member whose sign-in address differs from the one in the CRM.
STAFF_EMAIL_DOMAINS=1to100advisors.com
EXTRA_ALLOWED_EMAILS=

# ---- Email (magic links) — server-side only ----
# Same Google Workspace mailbox as the Aligned KPIs app. With none of these set,
# the magic link is printed to the server console instead of emailed, which is
# how local sign-in works without a mail provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@1to100advisors.com
SMTP_PASS=
MAIL_FROM=ITA Directory <notifications@1to100advisors.com>
# Optional: if set, Resend is used instead of SMTP.
RESEND_API_KEY=

# ---- TESTING MODE — a login bypass. Leave UNSET in production. ----
# "1" puts a "TESTING MODE ON" button on the sign-in page that skips
# authentication entirely and opens the directory. Anything else (or unset)
# and the button doesn't render AND the bypass is refused server-side.
#
# It exists so the app can be clicked through without waiting on a magic-link
# email. It is a documented way past the only thing protecting 203 members'
# contact details, so:
#   · UNSET IT BEFORE SHARING THE URL WITH MEMBERS. In Vercel that takes effect
#     immediately — the sign-in page is dynamic and re-reads it per request.
#   · Sessions already created through the bypass survive until sign-out, and
#     show a red TESTING MODE banner on every page for as long as they last.
TESTING_MODE=0

# ---- Local development ----
# "1" forces the local CSV fixture (data/ProfileSelectorData.csv) even when the
# Sheets credentials exist. Leave 0 in production. Note that with no sheet
# configured the app falls back to the fixture anyway.
USE_MOCK_DATA=0
